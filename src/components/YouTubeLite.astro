---
// Carga el iframe solo al pulsar play → página rápida
const { id, title } = Astro.props;
---
<div class="yt relative aspect-video overflow-hidden rounded-xl bg-black" data-id={id}>
  <button type="button" class="group absolute inset-0 h-full w-full" aria-label={`Reproducir ${title}`}>
    <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" class="h-full w-full object-cover opacity-90 transition group-hover:opacity-100" />
    <span class="absolute inset-0 grid place-items-center">
      <span class="grid h-16 w-16 place-items-center rounded-full bg-accent text-2xl text-white shadow-lg transition group-hover:scale-110">▶</span>
    </span>
  </button>
</div>
<script>
  document.querySelectorAll<HTMLElement>('.yt').forEach((el) => {
    el.querySelector('button')?.addEventListener('click', () => {
      el.innerHTML = `<iframe class="absolute inset-0 h-full w-full" src="https://www.youtube-nocookie.com/embed/${el.dataset.id}?autoplay=1" title="Vídeo" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>`;
    });
  });
</script>
