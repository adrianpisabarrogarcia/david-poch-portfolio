---
import YouTubeLite from './YouTubeLite.astro';
import type { Project } from '../data/site';
const { p } = Astro.props as { p: Project };
---
<article class="card group flex h-full flex-col !p-4">
  {p.embed ? (
    <YouTubeLite id={p.embed} title={p.title} />
  ) : (
    <a href={p.url} target="_blank" rel="noopener noreferrer" aria-label={`Abrir ${p.title}`}
       class="relative grid aspect-video place-items-center overflow-hidden rounded-xl bg-gradient-to-br from-accent/90 via-orange-600 to-amber-500">
      <span class="absolute -right-6 -top-6 h-28 w-28 rounded-full bg-white/15 transition-transform duration-500 group-hover:scale-150"></span>
      <span class="absolute -bottom-8 -left-4 h-24 w-24 rounded-full bg-black/10 transition-transform duration-500 group-hover:scale-150"></span>
      <span class="relative text-5xl drop-shadow transition-transform duration-300 group-hover:scale-125 group-hover:-rotate-6">{p.icon}</span>
    </a>
  )}
  <div class="flex flex-1 flex-col px-1 pt-4">
    <div class="flex items-center gap-2">
      <span class="rounded-full bg-stone-100 px-2.5 py-0.5 text-xs font-medium text-stone-600">{p.label}</span>
      {p.featured && <span class="rounded-full bg-accent/15 px-2.5 py-0.5 text-xs font-semibold text-accent">★ Destacado</span>}
    </div>
    <h3 class="mt-3 text-lg font-semibold leading-snug">{p.title}</h3>
    <p class="mt-1 flex-1 text-sm text-stone-600">{p.role}</p>
    <a href={p.url} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-accent transition-all hover:gap-2">Ver proyecto <span aria-hidden="true">↗</span></a>
  </div>
</article>
