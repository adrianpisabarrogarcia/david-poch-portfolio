---
import '../styles/global.css';
import { site, nav } from '../data/site';
interface Props { title: string; description?: string }
const { title, description = site.description } = Astro.props;
const fullTitle = title === 'Inicio' ? `${site.name} · Comunicador Audiovisual y Productor de TV` : `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = `${site.url}/og.jpg`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  image: `${site.url}/david.webp`,
  jobTitle: 'Comunicador Audiovisual y Productor de televisión',
  description,
  knowsLanguage: ['es', 'ca', 'en'],
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Universidad Carlos III de Madrid' },
    { '@type': 'CollegeOrUniversity', name: 'Universitat de Barcelona' },
  ],
  worksFor: { '@type': 'Organization', name: 'Atresmedia' },
  sameAs: [site.linkedin],
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#09090b" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="image" href="/david.webp" type="image/webp" />
    <script is:inline>
      document.documentElement.classList.add('js');
      try { var t = localStorage.getItem('theme') || 'dark'; } catch (e) { var t = 'dark'; }
      if (t === 'dark') document.documentElement.classList.add('dark');
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="sticky top-0 z-20 border-b border-stone-200 bg-stone-50/90 backdrop-blur">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
        <a href="/" class="font-bold tracking-tight">David Poch<span class="text-accent">.</span></a>
        <nav aria-label="Principal" class="ml-auto hidden gap-1 md:flex">
          {nav.map((n) => (
            <a href={n.href} data-nav
               class="nav-link rounded-full px-3 py-1.5 text-sm font-medium text-stone-600 transition hover:text-accent">{n.label}</a>
          ))}
        </nav>
        <button type="button" id="theme-toggle" aria-label="Cambiar tema" title="Cambiar tema"
          class="ml-2 grid h-9 w-9 place-items-center rounded-full border border-stone-300 bg-surface text-lg transition hover:rotate-12 hover:scale-110 hover:border-accent">
          <span class="hidden dark:inline">☀️</span><span class="dark:hidden">🌙</span>
        </button>
      </div>
      <!-- Pestañas móvil: barra desplazable -->
      <nav aria-label="Principal móvil" class="flex gap-2.5 overflow-x-auto px-4 pb-4 pt-0.5 [scrollbar-width:none] md:hidden">
        {nav.map((n) => (
          <a href={n.href} data-nav
             class="shrink-0 rounded-full border border-stone-200 bg-surface px-4 py-2 text-sm font-medium text-stone-600">{n.label}</a>
        ))}
      </nav>
    </header>
    <main class="mx-auto max-w-5xl px-4"><slot /></main>
    <footer class="reveal in border-t border-stone-200 py-6 text-center text-sm text-stone-500">© {new Date().getFullYear()} {site.name}</footer>
  <script>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
      });

      // Reveal on scroll con escalonado
      const targets = document.querySelectorAll('main section:not(#inicio) :is(h2, h3.text-2xl, p.max-w-3xl, .card, ol > li, a.card)');
      const seen = new Map<Element, number>();
      targets.forEach((el) => {
        const p = el.parentElement!;
        const i = seen.get(p) ?? 0; seen.set(p, i + 1);
        el.classList.add('reveal');
        (el as HTMLElement).style.setProperty('--d', Math.min(i, 5) * 90 + 'ms');
      });
      const rv = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { const t = e.target as HTMLElement; t.classList.add('in'); rv.unobserve(t); setTimeout(() => { t.classList.remove('reveal', 'in'); t.style.removeProperty('--d'); }, 1400); } }), { threshold: 0.12 });
      targets.forEach((el) => rv.observe(el));

      const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav]');
      const on = (id: string) => links.forEach((a) => {
        const active = a.getAttribute('href') === '#' + id;
        a.classList.toggle('!bg-accent', active);
        a.classList.toggle('!text-white', active);
        if (active) a.scrollIntoView({ block: 'nearest', inline: 'center' });
      });
      const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && on(e.target.id)), { rootMargin: '-40% 0px -55% 0px' });
      document.querySelectorAll('main section[id]').forEach((s) => io.observe(s));
    </script>
  </body>
</html>
